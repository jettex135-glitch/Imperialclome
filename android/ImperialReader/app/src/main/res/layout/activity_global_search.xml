<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/black">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/black" app:title="Global search"
        app:navigationIcon="@drawable/ic_arrow_back"/>
    <EditText android:id="@+id/queryInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="4dp"
        android:hint="Search all sources, books and web novels"
        android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1"
        android:importantForAutofill="no"
        android:textColor="@color/on_surface" android:textColorHint="@color/on_surface_variant"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="12dp">
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkCombine"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Combine sources into one title (all chapters, latest first)"
            android:textColor="@color/on_surface" android:textSize="13sp"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkOnlyResults"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Show only sources with results"
            android:textColor="@color/on_surface" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView
            android:id="@+id/searchProgress"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/on_surface_variant"
            android:textSize="12sp" android:paddingEnd="8dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openChallengeSource"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="0dp" android:minHeight="40dp"
            android:text="Open WebView" android:textSize="11sp"
            android:visibility="gone"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryFailedSources"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="40dp" android:text="Retry failed sources"
            android:textSize="12sp" android:enabled="false"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.imperialreader.ui.common.StarSpriteView
            android:id="@+id/searchSprite"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="6dp"
            android:elevation="4dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:id="@+id/emptyText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:padding="32dp" android:gravity="center"
            android:textColor="@color/on_surface_variant" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
